
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flytripvisa-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "GITHUB_REPOSITORY": "guolongli1997-spec/flytripvisa-mcp-server"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
   "ai": {
    "binding": "AI",
    "remote": true
  },
  "observability": {
    "enabled": true
  }
}
