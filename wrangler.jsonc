
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fly-dragon-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flytripvisa-db",
      "database_id": "a49b13c8-e420-48b4-8967-f9752e1bc5fa"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "flytripvisa-miniprogram"
    }
  ],
  "vars": {
    "AI_MODEL": "@hf/nousresearch/hermes-2-pro-mistral-7b"
  },
  "observability": {
    "enabled": true
  }
}
